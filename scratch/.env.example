# copy to scratch/.env
KLAVIYO_API_KEY=pk_...                     # private API key of a TEST account (suites create/delete data)
KLAVIYO_CLIENT_ID=                         # OAuth app (needed for oauth_* suites / webhooks)
KLAVIYO_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8090/oauth/callback   # the sink; no ngrok needed for OAuth
WEBHOOK_BASE_URL=https://<ngrok>           # public URL of the sink, webhooks only (ngrok http 8090)
TEST_DOMAIN=nickdnktech.com                # e-mail domain for synthetic profiles
SMOKE_RECORD=1                             # write scratch/recordings/*.jsonl for tests/fixtures/build.php
SCRUB_TERMS="yourcompany.com,Your Company Name,event:yourkey.=event:acme."   # identity strings to neutralise (term or term=replacement); quote when a value contains =
